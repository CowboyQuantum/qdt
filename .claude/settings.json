{
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(bash scripts/*)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git checkout*)",
      "Bash(git add*)",
      "Bash(git commit*)"
